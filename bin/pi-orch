#!/usr/bin/env bash
# Launcher do orquestrador: carrega a extensão só nesta sessão (não altera o Pi global).
set -euo pipefail
# Resolve symlinks (ex.: ~/.local/bin/pi-orch) antes de localizar o repositório.
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
if [ "${HERDR_ENV:-}" != "1" ] || [ -z "${HERDR_PANE_ID:-}" ]; then
  echo "pi-orch: rode dentro de um pane do Herdr (HERDR_ENV=1 e HERDR_PANE_ID definidos)" >&2
  exit 1
fi
export PI_ORCH_WORKER_EXT="$HERE/src/worker-ext.ts"
# O orquestrador não executa trabalho de projeto: lê (read/grep/find/ls) e delega por orch_*.
# Sem bash, edit, write nem subagents (filhos ocultos). Trabalho vai para workers Herdr.
exec pi --exclude-tools bash,edit,write,read,grep,find,ls,subagent,subagents_enable,bg_wait,subagent_supervisor -e "$HERE/src/index.ts" "$@"
