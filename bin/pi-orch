#!/usr/bin/env bash
# Alias de compatibilidade: pi-orch executa bin/pi-factory com os mesmos argumentos e ambiente.
# Não há lógica própria aqui; mudanças de comportamento vão em bin/pi-factory.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
exec bash "$HERE/pi-factory" "$@"
